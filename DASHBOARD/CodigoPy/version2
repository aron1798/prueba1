    def cargar_datos_auto(self):
        """Carga datos automáticamente sin necesidad de botón"""
        mes = self.mes_seleccionado.get()
        ano = self.ano_seleccionado.get()
        
        if not mes or not ano:
            return
        
        self.status_var.set("Cargando datos...")
        thread = threading.Thread(target=self.ejecutar_consulta, args=(ano, mes))
        thread.daemon = True
        thread.start()

    def get_connection(self):
        """Establece conexión con SQL Server"""
        connection_string = (
            f"DRIVER={{SQL Server}};"
            f"SERVER={self.server};"
            f"DATABASE={self.database};"
            f"UID={self.username};"
            f"PWD={self.password}"
        )
        return pyodbc.connect(connection_string)

    def ejecutar_consulta(self, ano, mes):
        """Ejecuta la consulta en hilo separado"""
        try:
            if not self.query_sql:
                self.root.after(0, lambda: self.mostrar_error("No se pudo cargar el query desde GitHub"))
                return
                
            # Primero cargar datos de matrículas del mes seleccionado
            self.datos_matriculas = self.cargar_datos_matriculas(ano, mes)
                
            conn = self.get_connection()
            cursor = conn.cursor()
            
            cursor.execute(self.query_sql, ano, mes)
            rows = cursor.fetchall()
            
            # Convertir a lista de diccionarios
            datos_originales = []
            columnas_completas = ['num_indice', 'dsc_det_programa', 'flg_activo', 'fch_inicio', 
                                 'cod_frecuencia', 'cod_estado', 'dsc_programa', 'Inscritos_Totales', 
                                 'Inscritos_Retirados', 'Inscritos_Activos']
            
            for row in rows:
                registro = {}
                for i, col in enumerate(columnas_completas):
                    registro[col] = row[i]
                datos_originales.append(registro)
            
            conn.close()
            
            print(f"📊 Datos obtenidos de BD: {len(datos_originales)} cursos")
            
            # Aplicar personalizaciones y reemplazos
            self.datos = self.aplicar_personalizaciones(datos_originales)
            
            # Actualizar UI en hilo principal
            self.root.after(0, self.mostrar_resultados)
            
        except Exception as e:
            self.root.after(0, lambda: self.mostrar_error(f"Error: {str(e)}"))

    def mostrar_resultados(self):
        """Muestra los resultados en la tabla"""
        # Limpiar tabla
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        if not self.datos:
            self.status_var.set("No hay datos para el mes seleccionado")
            self.stats_var.set("0 cursos encontrados")
            return
        
        # Insertar datos
        for registro in self.datos:
            valores = [registro.get(col, '') for col in self.columnas]
            self.tree.insert('', tk.END, values=valores)
        
        # Calcular estadísticas
        total_cursos = len(self.datos)
        total_inscritos = sum(registro.get('Inscritos_Totales', 0) for registro in self.datos)
        total_activos = sum(registro.get('Inscritos_Activos', 0) for registro in self.datos)
        total_inscritos_mes = sum(registro.get('Inscritos_Mes', 0) for registro in self.datos)
        
        # Obtener nombre del mes
        meses_nombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                        'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']
        mes_nombre = meses_nombres[int(self.mes_seleccionado.get()) - 1]
        
        self.stats_var.set(
            f"📊 {total_cursos} cursos en {mes_nombre} | 🎯 {total_inscritos} inscritos totales | "
            f"✅ {total_activos} activos | 📈 {total_inscritos_mes} inscritos del mes"
        )
        self.status_var.set(f"✅ Datos actualizados - {len(self.datos)} registros")
        
        print(f"🎯 Dashboard actualizado: {total_cursos} cursos mostrados")

    def mostrar_error(self, mensaje):
        messagebox.showerror("Error", mensaje)
        self.status_var.set("Error al cargar datos")

    def iniciar_auto_actualizacion(self):
        """Inicia la actualización automática cada 5 minutos"""
        intervalo = self.config_data.get('config_general', {}).get('auto_update_minutos', 5) * 60000
        self.auto_refresh_id = self.root.after(intervalo, self.auto_actualizar)

    def auto_actualizar(self):
        """Actualización automática cada 5 minutos"""
        if self.mes_seleccionado.get() and self.ano_seleccionado.get():
            self.status_var.set("🔄 Actualización automática...")
            self.ejecutar_consulta(self.ano_seleccionado.get(), self.mes_seleccionado.get())
        
        # Programar próxima actualización
        self.iniciar_auto_actualizacion()

    def exportar_excel(self):
        """Exporta los datos a Excel"""
        if not self.datos:
            messagebox.showwarning("Advertencia", "No hay datos para exportar")
            return
        
        try:
            df = pd.DataFrame(self.datos)
            df_exportar = df[self.columnas]
            archivo = f"cursos_{self.ano_seleccionado.get()}_{self.mes_seleccionado.get()}.xlsx"
            df_exportar.to_excel(archivo, index=False)
            messagebox.showinfo("Éxito", f"Datos exportados a {archivo}")
        except Exception as e:
            messagebox.showerror("Error", f"No se pudo exportar: {str(e)}")

def main():
    root = tk.Tk()
    app = DashboardCursos(root)
    root.mainloop()

if __name__ == "__main__":
    main()
